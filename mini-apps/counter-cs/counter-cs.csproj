<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- A reactor component (exports init/update, no Main) -> Library, mirroring
         the official componentize-dotnet `wasi.lib` template. -->
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>CounterCs</RootNamespace>
    <AssemblyName>counter_cs</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Setting the RID in the project body (not only via the SDK props) is what
         makes `restore` produce the net10.0/wasi-wasm target. -->
    <RuntimeIdentifier>wasi-wasm</RuntimeIdentifier>
    <UseAppHost>false</UseAppHost>
    <PublishTrimmed>true</PublishTrimmed>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BytecodeAlliance.Componentize.DotNet.Wasm.SDK" Version="0.8.0-preview00011" />
    <!-- RID-specific NativeAOT-LLVM cross-compiler for this build host (a
         documented componentize-dotnet step; the SDK leaves its version empty). -->
    <PackageReference Include="runtime.$(NETCoreSdkPortableRuntimeIdentifier).microsoft.dotnet.ilcompiler.llvm" Version="10.0.0-rc.1.26306.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- The one shared contract, same wit/world.wit the Rust mini-apps and the
         host generate from. -->
    <Wit Include="../../wit/world.wit" World="mini-app" />
  </ItemGroup>

</Project>
